{
  "name": "deck-presenter-agent-builder",
  "version": "0.0.0",
  "description": "Turn a deck and its speaker notes into a live AI presenter agent on Kaltura.",
  "license": "Apache-2.0",
  "author": "Zohar Babin",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "deck-presenter-agent-builder": "bin/create-project.mjs"
  },
  "files": [
    "bin/",
    "engine/",
    "client/",
    "templates/",
    "skills/",
    ".claude-plugin/",
    "docs/",
    ".env.example",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "doctor": "node bin/doctor.mjs",
    "check-template-update": "node bin/check-template-update.mjs",
    "scan": "node bin/scan-leaks.mjs",
    "sync-vendored": "node bin/sync-vendored.mjs",
    "lint-prompts": "node bin/lint-prompts.mjs --project demo && node bin/lint-prompts.mjs --project fixtures/smoke-project",
    "eval-retrieval": "node bin/eval-retrieval.mjs --project demo",
    "eval": "node engine/eval.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kaltura/intelligent-agents": "github:kaltura/intelligent-agents-sdk#v1.23.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
