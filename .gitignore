# Credentials. Never commit any of these.
.env
.env.*
!.env.example

# Raw deck input and working files. These belong in a project repo, not here.
# demo/ is the exception: its fake deck outline and speaker notes are fictional
# and meant to be committed as a worked example.
input/
!demo/input/
!demo/input/**
*.pdf
!demo/data/deck.pdf
*.pptx
!test/fixtures/sample-deck.pptx
*.ppt
*.key

# Real deck and knowledge-base content. Only demo/ may hold generated content,
# and only for the fictional demo product.
data/slides/
data/kb/
!demo/**/data/slides/
!demo/**/data/kb/

# Per-project runtime state
.provisioning-state.json
.deploy-result.json
.verify-snapshots/

# Local-only notes and lists handed to an agent as context, never committed
*.local.md
*.local.txt
.porting-source.local.md
.blocked-strings.local.txt

# Reference implementation staged for porting. Holds real customer content and
# real account ids. Read it, write generic code into engine/ and client/.
# Nothing under here may ever be committed.
port/

# Build output
dist/
dist.html
*.tmp-*
.bundle-entry.tmp.js

# Playwright E2E run artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Node
node_modules/
npm-debug.log*
.npm

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
