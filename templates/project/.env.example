# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Get these from your Kaltura account: KMC > Settings > Integration Settings.

# Your Kaltura account id. A number.
KALTURA_PARTNER_ID=

# The admin secret for that account. Treat it like a root password: it can do
# anything on the account. The engine exchanges it for a short-lived session key
# and never writes it to a bundle, a log, or provisioning state.
KALTURA_ADMIN_SECRET=

# Optional. Defaults to https://cdnapisec.kaltura.com/api_v3 when unset.
# Set it only if your account is on a different service URL. Include the
# /api_v3 path if you set this: the SDK appends /service/... directly to it.
KALTURA_SERVICE_URL=

# Optional. The Messaging API base URL used by features.followUpEmail and
# features.feedback. The SDK defaults to the standard region when unset. Set
# it only if your account is on a different Messaging cluster.
KALTURA_MESSAGING_URL=
