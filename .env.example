# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Get these from your Kaltura account: KMC > Settings > Integration Settings.

# Your Kaltura account id. A number.
KALTURA_PARTNER_ID=

# The admin secret for that account. Treat it like a root password: it can do
# anything on the account. The engine exchanges it for a short-lived session key
# and never writes it to a bundle, a log, or provisioning state.
KALTURA_ADMIN_SECRET=

# Optional. Defaults to https://cdnapisec.kaltura.com/api_v3 when unset.
# Set it only if your account is on a different service URL. Include the
# /api_v3 path if you set this: the SDK appends /service/... directly to it.
KALTURA_SERVICE_URL=

# Optional. The player/widget id used by the deployed page. Defaults to the
# account default (_<partnerId>) when unset.
KALTURA_WIDGET_ID=

# Required only if features.followUpEmail or features.feedback is on. The
# Messaging API base URL for your account's region. Ask your Kaltura account
# contact for this account's region and messaging base URL.
KALTURA_MESSAGING_URL=

# Optional. Comma-separated email addresses. When set, update-followup.mjs and
# update-feedback.mjs send the live lifecycle rule's email to these addresses
# instead of project.json's configured recipients. Use this to route test runs
# to your own inbox without editing tracked project.json.
EMAIL_RECIPIENTS_OVERRIDE=
